{
  "name": "Rent-A-Car",
  "valueTypes": [
    { "name": "CarGroup",    "kind": "categorical",    "literals": ["economy", "compact", "luxury"] },
    { "name": "MoneyAmount", "kind": "nonCategorical" }
  ],
  "entityTypes": [
    {
      "name": "Rental",
      "attributes": [
        { "name": "startingDay", "valueType": "String" },
        { "name": "endingDay",   "valueType": "String" },
        { "name": "totalDays",   "valueType": "Integer", "derivationRule": "self.endingDay - self.startingDay" }
      ]
    },
    {
      "name": "RentalLine",
      "attributes": [
        { "name": "quantity", "valueType": "Integer" }
      ]
    },
    {
      "name": "Vehicle",
      "isAbstract": true,
      "attributes": [
        { "name": "licensePlate", "valueType": "String" }
      ]
    },
    {
      "name": "Car",
      "parent": "Vehicle",
      "attributes": [
        { "name": "group", "valueType": "CarGroup" }
      ]
    },
    {
      "name": "Person",
      "attributes": [
        { "name": "name", "valueType": "String" }
      ]
    },
    {
      "name": "PremiumCustomer",
      "isDerived": true,
      "derivationExpression": "Person.rentals->size() > 10",
      "parent": "Person"
    }
  ],
  "eventTypes": [
    { "name": "rentalStarted",   "entityType": "Rental" },
    { "name": "rentalCompleted", "entityType": "Rental" }
  ],
  "factTypes": [
    {
      "name": "RentalHasLines",
      "isAggregation": true,
      "roles": [
        { "name": "rental",     "entityType": "Rental",     "lower": 1, "upper": 1  },
        { "name": "rentalLine", "entityType": "RentalLine",  "lower": 0, "upper": "*" }
      ]
    },
    {
      "name": "RentalInvolvesCar",
      "roles": [
        { "name": "rental", "entityType": "Rental", "lower": 0, "upper": "*" },
        { "name": "car",    "entityType": "Car",    "lower": 1, "upper": 1  }
      ]
    },
    {
      "name": "RentalMadeByPerson",
      "roles": [
        { "name": "rental", "entityType": "Rental", "lower": 0, "upper": "*" },
        { "name": "renter", "entityType": "Person", "lower": 1, "upper": 1  }
      ]
    }
  ]
}
