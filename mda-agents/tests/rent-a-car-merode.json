{
  "name": "Rent-A-Car (MERODE)",
  "domainTypes": [
    { "name": "CarGroup",    "kind": "categorical",    "literals": ["economy", "compact", "luxury"] },
    { "name": "MoneyAmount", "kind": "nonCategorical" }
  ],
  "objectTypes": [
    {
      "name": "Car",
      "attributes": [
        { "name": "licensePlate", "type": "String"   },
        { "name": "group",        "type": "CarGroup" },
        { "name": "mileage",      "type": "Integer"  }
      ],
      "lifecycleStates": ["registered"]
    },
    {
      "name": "Branch",
      "attributes": [
        { "name": "name", "type": "String" },
        { "name": "city", "type": "String" }
      ],
      "lifecycleStates": ["open"]
    },
    {
      "name": "Person",
      "attributes": [
        { "name": "fullName", "type": "String" },
        { "name": "email",    "type": "String" }
      ],
      "lifecycleStates": ["registered"]
    },
    {
      "name": "Rental",
      "attributes": [
        { "name": "startingDay",   "type": "String"      },
        { "name": "endingDay",     "type": "String"      },
        { "name": "carGroup",      "type": "CarGroup"    },
        { "name": "depositAmount", "type": "MoneyAmount" },
        { "name": "invoiceAmount", "type": "MoneyAmount" }
      ],
      "lifecycleStates": ["active", "depositPaid", "returned", "invoicePaid"]
    },
    {
      "name": "RentalLine",
      "attributes": [
        { "name": "quantity",    "type": "Integer" },
        { "name": "description", "type": "String"  }
      ],
      "lifecycleStates": ["active"]
    },
    {
      "name": "Invoice",
      "attributes": [
        { "name": "amount", "type": "MoneyAmount" },
        { "name": "paidOn", "type": "String"      }
      ],
      "lifecycleStates": ["issued", "paid"]
    }
  ],
  "existenceDependencies": [
    { "name": "RentalDependsOnCar",         "dependent": "Rental",     "master": "Car",        "lower": 1, "upper": 1 },
    { "name": "RentalDependsOnPerson",      "dependent": "Rental",     "master": "Person",     "lower": 1, "upper": 1 },
    { "name": "RentalDependsOnBranch",      "dependent": "Rental",     "master": "Branch",     "lower": 1, "upper": 1 },
    { "name": "RentalLineDependsOnRental",  "dependent": "RentalLine", "master": "Rental",     "lower": 1, "upper": 1 },
    { "name": "InvoiceDependsOnRentalLine", "dependent": "Invoice",   "master": "RentalLine", "lower": 1, "upper": 1 }
  ],
  "businessEventTypes": [
    { "name": "registerCar",         "objectType": "Car",        "role": "C" },
    { "name": "updateCarMileage",    "objectType": "Car",        "role": "M", "effects": [{ "attribute": "mileage" }] },
    { "name": "deregisterCar",       "objectType": "Car",        "role": "E" },
    { "name": "openBranch",          "objectType": "Branch",     "role": "C" },
    { "name": "closeBranch",         "objectType": "Branch",     "role": "E" },
    { "name": "registerPerson",      "objectType": "Person",     "role": "C" },
    { "name": "updatePersonDetails", "objectType": "Person",     "role": "M", "effects": [{ "attribute": "fullName" }, { "attribute": "email" }] },
    { "name": "deregisterPerson",    "objectType": "Person",     "role": "E" },
    { "name": "startRental",         "objectType": "Rental",     "role": "C" },
    { "name": "extendRental",        "objectType": "Rental",     "role": "M", "fromState": "active",      "toState": "active",      "effects": [{ "attribute": "endingDay" }] },
    { "name": "payDeposit",          "objectType": "Rental",     "role": "M", "fromState": "active",      "toState": "depositPaid", "effects": [{ "attribute": "depositAmount" }] },
    { "name": "returnCar",           "objectType": "Rental",     "role": "M", "fromState": "depositPaid", "toState": "returned" },
    { "name": "payInvoice",          "objectType": "Rental",     "role": "M", "fromState": "returned",    "toState": "invoicePaid", "effects": [{ "attribute": "invoiceAmount" }] },
    { "name": "completeRental",      "objectType": "Rental",     "role": "E" },
    { "name": "addRentalLine",       "objectType": "RentalLine", "role": "C" },
    { "name": "updateRentalLine",    "objectType": "RentalLine", "role": "M", "effects": [{ "attribute": "quantity" }, { "attribute": "description" }] },
    { "name": "removeRentalLine",    "objectType": "RentalLine", "role": "E" },
    { "name": "issueInvoice",        "objectType": "Invoice",    "role": "C" },
    { "name": "markInvoicePaid",     "objectType": "Invoice",    "role": "M", "fromState": "issued", "toState": "paid", "effects": [{ "attribute": "paidOn" }] },
    { "name": "closeInvoice",        "objectType": "Invoice",    "role": "E" }
  ]
}
