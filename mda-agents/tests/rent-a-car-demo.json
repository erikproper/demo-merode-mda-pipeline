{
  "name": "Rent-A-Car (DEMO)",
  "valueTypes": [
    { "name": "CarGroup",    "kind": "categorical" },
    { "name": "MoneyAmount", "kind": "nonCategorical" },
    {
      "name": "BookingDetail",
      "kind": "associationClass",
      "triggerEventType": "rentalStarted",
      "relatesEntityTypes": ["Rental", "Car"],
      "attributes": [
        { "name": "pricePerDay", "valueType": "Integer" },
        { "name": "notes",       "valueType": "String"  }
      ]
    }
  ],
  "entityTypes": [
    {
      "name": "Car",
      "attributes": [
        { "name": "licensePlate", "valueType": "String"   },
        { "name": "group",        "valueType": "CarGroup" },
        { "name": "mileage",      "valueType": "Integer"  }
      ]
    },
    {
      "name": "SpecialCar",
      "parent": "Car",
      "triggerEventType": "carRegistered"
    },
    {
      "name": "Branch",
      "attributes": [
        { "name": "name", "valueType": "String" },
        { "name": "city", "valueType": "String" }
      ]
    },
    {
      "name": "Person",
      "attributes": [
        { "name": "fullName", "valueType": "String" },
        { "name": "email",    "valueType": "String" }
      ]
    },
    {
      "name": "PremiumCustomer",
      "isDerived": true,
      "parent": "Person"
    },
    {
      "name": "Rental",
      "attributes": [
        { "name": "startingDay", "valueType": "String"   },
        { "name": "endingDay",   "valueType": "String"   },
        { "name": "carGroup",    "valueType": "CarGroup" },
        { "name": "totalDays",   "valueType": "Integer", "derivationRule": "endingDay - startingDay" }
      ]
    },
    {
      "name": "ActiveRental",
      "parent": "Rental",
      "triggerEventType": "rentalStarted"
    },
    {
      "name": "DepositPaidRental",
      "parent": "Rental",
      "triggerEventType": "depositPaid",
      "attributes": [
        { "name": "depositAmount", "valueType": "MoneyAmount" }
      ]
    },
    {
      "name": "ReturnedRental",
      "parent": "Rental",
      "triggerEventType": "carReturned"
    },
    {
      "name": "InvoicePaidRental",
      "parent": "Rental",
      "triggerEventType": "invoicePaid",
      "attributes": [
        { "name": "invoiceAmount", "valueType": "MoneyAmount" }
      ]
    },
    {
      "name": "RentalLine",
      "attributes": [
        { "name": "quantity",    "valueType": "Integer" },
        { "name": "description", "valueType": "String"  }
      ]
    }
  ],
  "eventTypes": [
    { "name": "carRegistered",    "entityType": "Car"        },
    { "name": "mileageUpdated",   "entityType": "Car"        },
    { "name": "carDeregistered",  "entityType": "Car"        },
    { "name": "branchOpened",     "entityType": "Branch"     },
    { "name": "branchClosed",     "entityType": "Branch"     },
    { "name": "personRegistered", "entityType": "Person"     },
    { "name": "personUpdated",    "entityType": "Person"     },
    { "name": "personRemoved",    "entityType": "Person"     },
    { "name": "rentalStarted",    "entityType": "Rental"     },
    { "name": "rentalExtended",   "entityType": "Rental"     },
    { "name": "depositPaid",      "entityType": "Rental"     },
    { "name": "carReturned",      "entityType": "Rental"     },
    { "name": "invoicePaid",      "entityType": "Rental"     },
    { "name": "rentalCompleted",  "entityType": "Rental"     },
    { "name": "rentalLineAdded",  "entityType": "RentalLine" },
    { "name": "rentalLineUpdated","entityType": "RentalLine" },
    { "name": "rentalLineRemoved","entityType": "RentalLine" }
  ],
  "factTypes": [
    {
      "name": "RentalHasLines",
      "isAggregation": true,
      "roles": [
        { "name": "rental",     "entityType": "Rental",     "lower": 1, "upper": 1  },
        { "name": "rentalLine", "entityType": "RentalLine", "lower": 0, "upper": "*" }
      ]
    },
    {
      "name": "RentalInvolvesCar",
      "roles": [
        { "name": "rental", "entityType": "Rental", "lower": 0, "upper": "*" },
        { "name": "car",    "entityType": "Car",    "lower": 1, "upper": 1  }
      ]
    },
    {
      "name": "RentalMadeByPerson",
      "roles": [
        { "name": "rental",  "entityType": "Rental", "lower": 0, "upper": "*" },
        { "name": "renter",  "entityType": "Person", "lower": 1, "upper": 1  }
      ]
    },
    {
      "name": "RentalPickedUpAt",
      "roles": [
        { "name": "rental",  "entityType": "Rental", "lower": 0, "upper": "*" },
        { "name": "branch",  "entityType": "Branch", "lower": 1, "upper": 1  }
      ]
    },
    {
      "name": "RentalReturnedAt",
      "roles": [
        { "name": "rental",  "entityType": "Rental", "lower": 0, "upper": "*" },
        { "name": "branch",  "entityType": "Branch", "lower": 1, "upper": 1  }
      ]
    }
  ]
}
