# =============================================================================
# BIG Modelling Bus – local environment  (copy to .env and fill in values)
# =============================================================================

# MQTT Broker (HiveMQ CE via Docker Compose)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASSWORD=admin

# Bus routing
BUS_PREFIX=big
BUS_ENVIRONMENT_ID=dev

# =============================================================================
# Mendix Platform SDK credentials
# =============================================================================

# Personal Access Token – Mendix Developer Portal → User Settings → PATs
# Required scope: mx:modelrepository:repo:write
MENDIX_TOKEN=your_pat_here

# App UUID – Developer Portal → your App → General → Settings → App ID
MENDIX_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Target module inside the app (must already exist)
MENDIX_MODULE_NAME=MyFirstModule

# Branch to open/commit (Git repos: "main"; SVN repos: "trunk")
MENDIX_BRANCH=main
