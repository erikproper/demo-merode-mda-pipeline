{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "demo-schema.json",
  "title": "DEMO Fact Model (CIM)",
  "type": "object",
  "required": ["name", "entityTypes"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "valueTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/DemoValueType" }
    },
    "entityTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/EntityType" }
    },
    "factTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/FactType" }
    }
  },
  "$defs": {
    "DemoValueType": {
      "type": "object",
      "required": ["name", "kind", "literals"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string" },
        "kind":     { "type": "string", "enum": ["categorical"] },
        "literals": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "EntityType": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/AttributeType" }
        }
      }
    },
    "AttributeType": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":      { "type": "string" },
        "valueType": { "type": "string" }
      }
    },
    "FactType": {
      "type": "object",
      "required": ["name", "roles"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/Role" }
        }
      }
    },
    "Role": {
      "type": "object",
      "required": ["name", "entityType"],
      "additionalProperties": false,
      "properties": {
        "name":       { "type": "string" },
        "entityType": { "type": "string" },
        "lower":      { "type": "integer", "minimum": 0 },
        "upper": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string",  "enum": ["*"] }
          ]
        }
      }
    }
  }
}
