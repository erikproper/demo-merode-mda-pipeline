{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "demo-schema.json",
  "title": "DEMO Fact Model (CIM)",
  "type": "object",
  "required": ["name", "entityTypes"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "entityTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/EntityType" }
    }
  },
  "$defs": {
    "EntityType": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/AttributeType" }
        }
      }
    },
    "AttributeType": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":      { "type": "string" },
        "valueType": { "type": "string" }
      }
    }
  }
}
