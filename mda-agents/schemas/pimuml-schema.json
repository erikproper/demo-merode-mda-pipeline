{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pimuml-schema.json",
  "title": "pimUML Model (PIM)",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "enumerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Enumeration" }
    },
    "dataTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/DataType" }
    },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Class" }
    },
    "associations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Association" }
    },
    "generalizations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Generalization" }
    },
    "associationClasses": {
      "type": "array",
      "items": { "$ref": "#/$defs/AssociationClass" }
    },
    "stateMachines": {
      "type": "array",
      "items": { "$ref": "#/$defs/StateMachine" }
    }
  },
  "$defs": {
    "Enumeration": {
      "type": "object",
      "required": ["name", "literals"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string" },
        "literals": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "AssociationClass": {
      "type": "object",
      "required": ["name", "memberEnds"],
      "additionalProperties": false,
      "properties": {
        "name":             { "type": "string" },
        "triggerEvent":     { "type": "string" },
        "memberEnds": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/$defs/AssociationEnd" }
        },
        "ownedAttributes": {
          "type": "array", "items": { "$ref": "#/$defs/Property" }
        }
      }
    },
    "DataType": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" }
      }
    },
    "Generalization": {
      "type": "object",
      "required": ["child", "parent"],
      "additionalProperties": false,
      "properties": {
        "child":  { "type": "string" },
        "parent": { "type": "string" }
      }
    },
    "Class": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":                 { "type": "string" },
        "isAbstract":           { "type": "boolean" },
        "isDerived":            { "type": "boolean" },
        "derivationExpression": { "type": "string" },
        "ownedAttributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Property" }
        }
      }
    },
    "Property": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":           { "type": "string" },
        "type":           { "type": "string" },
        "defaultValue":   { "type": "string" },
        "isDerived":      { "type": "boolean" },
        "derivationRule": { "type": "string" },
        "isID":           { "type": "boolean" }
      }
    },
    "Association": {
      "type": "object",
      "required": ["name", "memberEnds"],
      "additionalProperties": false,
      "properties": {
        "name":                 { "type": "string" },
        "isAggregation":        { "type": "boolean" },
        "isDerived":            { "type": "boolean" },
        "derivationExpression": { "type": "string" },
        "triggerEvent":         { "type": "string" },
        "memberEnds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/AssociationEnd" }
        }
      }
    },
    "AssociationEnd": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "lower": { "type": "integer", "minimum": 0 },
        "upper": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string",  "enum": ["*"] }
          ]
        }
      }
    },
    "StateMachine": {
      "type": "object",
      "required": ["name", "entityType", "regions"],
      "additionalProperties": false,
      "properties": {
        "name":       { "type": "string" },
        "entityType": { "type": "string" },
        "regions":    { "type": "array", "items": { "$ref": "#/$defs/Region" } },
        "activities": { "type": "array", "items": { "$ref": "#/$defs/Activity" } }
      }
    },
    "Region": {
      "type": "object",
      "required": ["name", "forEvent", "states", "transitions"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string" },
        "forEvent":    { "type": "string" },
        "states":      { "type": "array", "items": { "$ref": "#/$defs/State" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/Transition" } }
      }
    },
    "State": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name":          { "type": "string" },
        "kind":          { "type": "string", "enum": ["initial", "false", "true"] },
        "entryActivity": { "type": "string" }
      }
    },
    "Transition": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from":          { "type": "string" },
        "to":            { "type": "string" },
        "trigger":       { "type": "string" },
        "alfExpression": { "type": "string" }
      }
    },
    "Activity": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name":       { "type": "string" },
        "kind":       { "type": "string", "enum": ["set", "create"] },
        "targetType": { "type": "string" }
      }
    }
  }
}
