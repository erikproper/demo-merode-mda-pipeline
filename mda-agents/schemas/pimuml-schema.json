{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pimuml-schema.json",
  "title": "pimUML Model (PIM)",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Class" }
    }
  },
  "$defs": {
    "Class": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "ownedAttributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Property" }
        }
      }
    },
    "Property": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      }
    }
  }
}
