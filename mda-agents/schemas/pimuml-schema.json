{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pimuml-schema.json",
  "title": "pimUML Model (PIM)",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Class" }
    },
    "associations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Association" }
    }
  },
  "$defs": {
    "Class": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "ownedAttributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Property" }
        }
      }
    },
    "Property": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "Association": {
      "type": "object",
      "required": ["name", "memberEnds"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "memberEnds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/AssociationEnd" }
        }
      }
    },
    "AssociationEnd": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "lower": { "type": "integer", "minimum": 0 },
        "upper": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string",  "enum": ["*"] }
          ]
        }
      }
    }
  }
}
